{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/eai-lab/contracts/evidence_record.schema.json",
  "title": "EAI Evidence Record",
  "description": "Links a bounded claim or classification to observable events. A record never upgrades missing evidence to mastery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "case_id",
    "claim_type",
    "source_event_ids",
    "assessment_status",
    "evidence_fit",
    "conclusion",
    "core_version"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "supported_performance",
        "independence",
        "retention",
        "transfer",
        "efficiency",
        "output_quality",
        "perception",
        "configuration"
      ]
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessment_status": {
      "type": "string",
      "enum": [
        "classified",
        "unknown",
        "not_applicable",
        "not_assessed",
        "not_triggered"
      ]
    },
    "evidence_fit": {
      "type": "string",
      "enum": [
        "F0",
        "F1",
        "F2",
        "F3",
        "F4",
        "UNKNOWN"
      ]
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_contribution": {
      "type": [
        "string",
        "null"
      ]
    },
    "core_version": {
      "type": "string",
      "const": "0.5.4"
    }
  }
}

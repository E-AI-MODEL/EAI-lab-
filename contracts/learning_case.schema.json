{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-ai-model.github.io/eai-lab/contracts/learning_case.schema.json",
  "title": "EAI Learning Case",
  "description": "Defines the learning goal, target operations and execution mode. It does not assert learner mastery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "mode",
    "learning_goal",
    "target_core_operations"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "real",
        "simulation"
      ]
    },
    "learning_goal": {
      "type": "string",
      "minLength": 1
    },
    "target_core_operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "P0",
          "P1",
          "P2",
          "P3",
          "P4",
          "P5",
          "P6"
        ]
      }
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
